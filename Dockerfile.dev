# syntax=docker/dockerfile:1

# Build stage: full toolchain, dev dependencies and build caches live here only.
FROM node:22.23.4-bookworm-slim AS builder
ARG NEXT_PUBLIC_VERSION
ARG NEXT_PUBLIC_GTM_ID
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_GTM_ID=$NEXT_PUBLIC_GTM_ID
ENV NEXT_TELEMETRY_DISABLED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

COPY . /app

# Keep the default store so pnpm hardlinks packages into node_modules. That
# shares duplicate files between packages; copying them would add ~1GB.
RUN pnpm install --frozen-lockfile
# prisma db push runs on container start. Download its engines at build time so
# the runtime image never has to reach binaries.prisma.sh.
RUN pnpm exec prisma --version
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

# These files are only needed to produce the build. Removing them here (before
# the final COPY) keeps them out of the runtime image.
RUN rm -rf apps/frontend/.next/cache \
           apps/frontend/.next/dev \
           apps/*/tsconfig.tsbuildinfo \
           node_modules/.cache \
           .nx

# Kept for .devcontainer and var/docker/docker-build.sh.
FROM builder AS devcontainer
COPY var/docker/nginx.conf /etc/nginx/nginx.conf
CMD ["sh", "-c", "nginx && pnpm run pm2"]

# Runtime stage: no compilers, no pnpm store, no build caches, no sources.
FROM node:22.23.4-bookworm-slim AS runner
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
ENV NEXT_TELEMETRY_DISABLED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
&& rm -rf /var/lib/apt/lists/*

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2 \
 && rm -rf /root/.npm

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx

WORKDIR /app

COPY --from=builder /app/package.json /app/pnpm-lock.yaml \
     /app/pnpm-workspace.yaml /app/.npmrc \
     /app/tsconfig.base.json /app/tsconfig.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps ./apps
# prisma-db-push runs at container start and needs the schema on disk.
COPY --from=builder /app/libraries/nestjs-libraries/src/database/prisma \
     ./libraries/nestjs-libraries/src/database/prisma
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

EXPOSE 5000

CMD ["sh", "-c", "nginx && pnpm run pm2"]
